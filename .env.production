# Public by nature (it ships in the browser bundle), so safe to commit. Google Apps Script web app
# that stores AI readiness assessment leads in a Google Sheet and sends the emails.
# Source: integrations/ai-readiness-apps-script/Code.gs  (to change it: redeploy the script, update this URL)
REACT_APP_AI_READINESS_ENDPOINT=https://script.google.com/macros/s/AKfycbxKA7TxuGxhg5FDs8Dd4HjRV_GbLOR75UI0FYlqVjKBboLlqSxW8wSUpXOSRcZu5fb8wQ/exec

# LinkedIn Insight Tag conversion fired when an assessment lead is confirmed saved. Leave empty
# until a conversion exists in Campaign Manager (Analyze > Conversion tracking > Create conversion >
# event-specific / JavaScript); then put its numeric id here and redeploy.
REACT_APP_LINKEDIN_LEAD_CONVERSION_ID=31731121

# Google Ads conversions, sent via the Google tag in public/index.html (AW-18495931723); see
# src/utils/googleAds.js. "Kişi": contact-email clicks. "AI Readiness Lead": confirmed AI-readiness
# leads.
REACT_APP_GOOGLE_ADS_CONTACT_SEND_TO=AW-18495931723/vWHMCP26qpIdEMuKxvNE
REACT_APP_GOOGLE_ADS_AI_READINESS_SEND_TO=AW-18495931723/sSwBCPLChpQdEMuKxvNE

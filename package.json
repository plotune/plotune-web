{
  "homepage": "https://www.plotune.net/",
  "name": "plotune-react",
  "version": "0.1.0",
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.16.4",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "js-cookie": "^3.0.5",
    "plotly.js-basic-dist-min": "^4.1.1",
    "posthog-js": "^1.434.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-plotly.js": "^4.1.0",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "react-scroll": "^1.9.3",
    "react-toastify": "^11.0.5",
    "remark-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3"
  },
  "scripts": {
    "start": "craco start",
    "build": "node scripts/generate-research-rss.cjs && craco build && node scripts/generate-static-routes.cjs",
    "test": "craco test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build && cp CNAME build/CNAME",
    "deploy": "gh-pages -d build",
    "generate:research-rss": "node scripts/generate-research-rss.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|@mdx-js|react-router|react-router-dom|@remix-run|react-plotly\\.js|plotly\\.js)/)",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
